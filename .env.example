# cp .env.example .env して埋める。.env は git に入らない。

# GitHub の PAT。PR の差分レビューと issue 起票に使う。
#   読むだけ        : contents: read, pull_requests: read
#   起票もする      : + issues: write
# 公開リポジトリを読むだけならトークン無しでも動く (60/時の制限つき)。
JUSTIC_GITHUB_TOKEN=

# L3 (設計内容の観点パス) を有効にする。既定は無効。
JUSTIC_L3=0
JUSTIC_BASE_URL=http://127.0.0.1:18080/v1
JUSTIC_MODEL=
JUSTIC_API_KEY=

# GitHub OAuth。利用者ごとにログインさせるときに使う。
# OAuth App は GitHub の Settings > Developer settings で作る。
#   Homepage URL              http://127.0.0.1:5180
#   Authorization callback URL http://127.0.0.1:5180/auth/callback
# 未設定なら上の JUSTIC_GITHUB_TOKEN で一人用として動く。
JUSTIC_OAUTH_CLIENT_ID=
JUSTIC_OAUTH_CLIENT_SECRET=
JUSTIC_SESSION_SECRET=
# 公開リポジトリだけなら public_repo で足りる (既定は repo)
JUSTIC_OAUTH_SCOPE=repo
